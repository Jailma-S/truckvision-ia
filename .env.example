# Copie para .env.local. Sem as variáveis do Supabase, o app roda em MODO DEMO (dados fictícios em memória).

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- IA (modelo agnóstico) ---
# anthropic (padrão) | openai | azure | gemini
AI_PROVIDER=anthropic
# Opcional: sobrescreve o modelo padrão do provedor (anthropic: claude-opus-5-5; ex. claude-sonnet-5-5 para custo menor)
AI_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
GEMINI_API_KEY=

# --- Agente de monitoramento (Vercel Cron) ---
CRON_SECRET=
